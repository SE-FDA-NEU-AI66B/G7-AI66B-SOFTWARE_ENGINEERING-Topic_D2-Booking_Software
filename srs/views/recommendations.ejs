<%- include('partials/header') %>
<h1>Recommendations</h1>
<p class="muted">
  Mode: <strong><%= mode %></strong>
  <% if (prefs.withOthers) { %>· watching with others<% } %>
  <% if (prefs.genres.length) { %>· <%= prefs.genres.join(', ') %><% } %>
  · <a href="/recommendations/setup">change</a>
</p>
<% if (!movies.length) { %>
  <p>No movies match right now.</p>
<% } %>
<ul class="cards">
  <% movies.forEach(m => { %>
    <li>
      <a href="/movie/<%= m.id %>"><strong><%= m.title %></strong></a> (<%= m.year %>)
      <div class="muted"><%= m.genres.join(', ') %> · <%= m.ageRating %>+ · ★ <%= m.rating %></div>
    </li>
  <% }) %>
</ul>
<%- include('partials/footer') %>
