<%- include('partials/header') %>
<h1>My ratings</h1>
<% if (!rated.length) { %>
  <p>You haven't rated anything yet.</p>
<% } %>
<ul class="cards">
  <% rated.forEach(m => { %>
    <li>
      <a href="/movie/<%= m.id %>"><%= m.title %></a> — <%= m.myScore %>/10
      <form method="post" action="/profile/ratings/<%= m.id %>/delete" style="display:inline">
        <button class="link">remove</button>
      </form>
    </li>
  <% }) %>
</ul>
<%- include('partials/footer') %>
